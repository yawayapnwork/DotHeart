# Shared secret the Android clients must send as the `token` form field.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WIDGET_TOKEN=change-me-to-a-long-random-value

# Directory used for the SQLite DB and stored image (Render persistent disk
# mount point in production, e.g. /var/data).
DATA_DIR=./data

# Optional overrides (defaults shown).
MAX_IMAGE_BYTES=2097152
MAX_MESSAGE_LENGTH=140
PORT=8000
LOG_LEVEL=INFO
