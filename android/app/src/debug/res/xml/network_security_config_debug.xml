<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only (see ../AndroidManifest.xml). Cleartext HTTP is denied by
  default and allowed only for the explicit local hosts below, so if
  DOTHEART_BASE_URL is ever pointed at a non-HTTPS production-like host, even
  a debug build still blocks it.

  LIMITATION: network-security-config has no CIDR/subnet syntax. A <domain>
  is a hostname or an exact IP literal, so "192.168.0.0/16" or "10.0.0.0/8"
  cannot be written here (such an entry is not a valid match and would never
  permit anything). To test against a local WiFi backend, add its exact
  address as another <domain> line below, e.g.
      <domain includeSubdomains="false">192.168.1.42</domain>
  or use an mDNS hostname with includeSubdomains="true" (e.g. "mybox.local").
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's alias for the host machine's loopback address. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
