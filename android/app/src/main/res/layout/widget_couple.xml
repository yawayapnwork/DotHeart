<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe layout: only FrameLayout/LinearLayout/ImageView/
     TextView/ProgressBar are used, all of which are on the AppWidget host's
     supported-view allowlist. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_image_description"
        android:src="@drawable/placeholder_heart" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/widget_message_scrim"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Responsive font sizing: shrinks automatically so a longer note
             still fits two lines on the smallest supported widget size
             (110dp, targetCellWidth=2) without being clipped mid-word. -->
        <TextView
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:textColor="@color/widget_message_text"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:text="@string/widget_default_message" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_refreshing"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_error_badge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:src="@drawable/ic_sync_error_badge"
        android:contentDescription="@string/widget_error_description"
        android:visibility="gone" />

</FrameLayout>
