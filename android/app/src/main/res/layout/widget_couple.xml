<?xml version="1.0" encoding="utf-8"?>
<!-- Brutalist telemetry layout: pure black, zero corner radius, zero
     decorative frames/scrims. RemoteViews-safe: only FrameLayout/ImageView/
     TextView are used, all on the AppWidget host's supported-view
     allowlist. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_bg">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="22dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/widget_image_description" />

    <!-- Single-line monospace telemetry readout, e.g.
         "[SYNC 14M AGO // LINK 200] > out for milk" - no background, no
         scrim, no rounded corners; text sits directly on the root's flat
         black. -->
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="4dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:textColor="@color/widget_fg"
        android:textSize="11sp"
        android:text="@string/widget_default_status" />

    <!-- Presence-link indicator: a few solid "pixels" (not 1-2 raw device
         pixels, which would be unreadable on any modern screen density) -
         full brightness when both users pinged within the sync window,
         dimmed (not hidden) otherwise. Brightness is toggled via
         setInt(...,"setImageAlpha",...) at render time, see
         CoupleWidgetProvider.render(). -->
    <ImageView
        android:id="@+id/link_indicator"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="3dp"
        android:src="@drawable/indicator_square"
        android:contentDescription="@string/widget_link_description" />

</FrameLayout>
