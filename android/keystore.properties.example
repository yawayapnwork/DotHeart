# Copy this file to android/keystore.properties (same directory) and fill
# in real values. android/keystore.properties is gitignored - never commit
# your actual keystore path or passwords.
#
# storeFile: use an ABSOLUTE path (or a leading ~ your shell expands before
# Gradle sees it - Gradle itself does NOT expand ~). A relative path here
# resolves against android/app/ (the module directory), not the repo root
# or android/ - absolute is far less surprising. Keeping the .jks file
# itself outside this repo entirely is strongly recommended.
#
# See RELEASE.md for how to generate the keystore with keytool, and for
# the equivalent DOTHEART_KEYSTORE_PATH / DOTHEART_KEYSTORE_PASSWORD /
# DOTHEART_KEY_ALIAS / DOTHEART_KEY_PASSWORD environment variables, which
# take effect only when this file is absent - useful for CI, where a
# checked-out repo has no local keystore.properties at all.

storeFile=/absolute/path/to/dotheart-release.jks
storePassword=change-me
keyAlias=dotheart
keyPassword=change-me
