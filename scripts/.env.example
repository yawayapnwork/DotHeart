# Config for scripts/push_art. Copy to one of:
#   ./.env                          (project-local, checked first)
#   ~/.config/dotheart/.env         (global, used from any directory)
# Real environment variables always take precedence over both files.

DOTHEART_SERVER_URL=https://dotheart.onrender.com

# Must match the backend's WIDGET_TOKEN value exactly (see the root
# .env.example) - these are two different environment variable names for
# the same shared secret, read by two different processes.
DOTHEART_TOKEN=change-me-to-the-same-value-as-the-backend-WIDGET_TOKEN
